{
  "appId": "com.voocstore.pos",
  "productName": "VOOC Store",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "extraResources": [
    {
      "from": "node_modules/sql.js/dist/sql-wasm.wasm",
      "to": "sql-wasm.wasm"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "VOOC Store",
    "artifactName": "VOOC-Store-Setup-${version}.${ext}",
    "uninstallDisplayName": "VOOC Store"
  },
  "portable": {
    "artifactName": "VOOC-Store-Portable-${version}.${ext}"
  }
}
